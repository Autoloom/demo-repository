# Auth0 application credentials (Applications > [App] > Settings in the Auth0 dashboard)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# API identifier to request access tokens for (APIs > [API] > Settings)
AUTH0_AUDIENCE=

# Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Base URL of this app, used for Auth0 callback/redirect URLs
APP_BASE_URL=http://localhost:3000

# Hosted backend that verifies the Auth0 access token and returns profile data
BACKEND_URL=
